# Copy to .env and fill in. Never commit .env.

PORT=3000

# Slack Incoming Webhook → design-requests GROUP channel
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Slack Bot User OAuth Token (xoxb-…) for personal DMs + /design modal
# Scopes: chat:write, im:write, users:read, users:read.email, commands
SLACK_BOT_TOKEN=

# Interactivity Request URL (Slack App → Interactivity & Shortcuts):
#   https://web-production-e4f0f.up.railway.app/api/slack/interactions
# Slash Command Request URL:
#   https://web-production-e4f0f.up.railway.app/api/slack/commands

# Agrim / design manager Slack member ID — DMs on new request + complete + lifecycle
# (fallback: lookup agrim@spyne.ai if empty and bot has users:read.email)
SLACK_MANAGER_ID=

# Public URL of this app (form + slash command links)
APP_URL=http://localhost:3000

# Marketing Central Design board (links in Slack)
MC_DESIGN_BOARD_URL=https://marketing-central-dashboard-production.up.railway.app/design

# MC ingest (same Postgres as Programs)
# MC_DESIGN_INGEST_URL=https://marketing-central-dashboard-production.up.railway.app/api/design/ingest
# MC_DESIGN_INGEST_SECRET=
