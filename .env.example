# Copy to .env and fill in. Never commit .env.

PORT=3000

# Slack Incoming Webhook for your design-requests channel
# Channel → Integrations → Incoming Webhooks → Add → copy URL
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Optional: public URL of this app (shown in Slack as “Open in dashboard”)
APP_URL=http://localhost:3000
